*NOT Gate

if(V(gate) == 0)
{
    total = I(p_Vg_indi_64_1.1_0_1.1) + I(n_Vd_indi_32_1.1_0_0);
}
else
{
    total = I(n_Vg_indi_32_0_1.1_0) + I(p_Vs_indi_64_0_1.1_1.1);
}

*gate source drain

*NAND 2 Gate

if(V(gate1) == 0 && V(gate2) == 0)
{
    total = 2*I(p_Vg_indi_64_1.1_0_1.1) + I(n_stack_64_00);
}
else if(V(gate1) == 0 && V(gate2) == 1.1)
{
    total = I(p_Vg_indi_64_1.1_0_1.1) + I(p_Vd_indi_64_1.1_1.1_1.1) + I(n_stack_64_01);
}
else if(V(gate1) == 1.1 && V(gate2) == 0)
{
    total = I(p_Vd_indi_64_1.1_1.1_1.1) + I(p_Vg_indi_64_1.1_0_1.1) + I(n_stack_64_10);
}
else
{
    total = 2*I(p_Vd_indi_64_0_1.1_1.1) + I(n_stack_64_11);
}

*NOR 2 Gate

