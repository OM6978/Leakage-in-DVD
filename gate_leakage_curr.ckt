}
else
{
    total = 2*I(n_Vg_indi_32_0_1.1_0) + I(p_stack_128_11);
}

*AND 2 Gate

if(V(gate1) == 0 && V(gate2) == 0)
{
    total = total_nand(00) + total_not(1);
}
else if(V(gate1) == 0 && V(gate2) == 1.1)
{
    total = total_nand(01) + total_not(1);
}
else if(V(gate1) == 1.1 && V(gate2) == 0)
{
    total = total_nand(10) + total_not(1);
}
else
{
    total = total_nand(11) + total_not(0);
}

*OR 2 Gate

