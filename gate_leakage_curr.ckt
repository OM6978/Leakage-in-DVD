else if(V(gate1) == 0 && V(gate2) == 1.1)
{
    total = total_nor(01) + total_not(0);
}
else if(V(gate1) == 1.1 && V(gate2) == 0)
{
    total = total_nor(10) + total_not(0);
}
else
{
    total = total_nor(11) + total_not(0);
}

